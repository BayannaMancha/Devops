pipeline {
    agent any

    stages {
        stage('Backup Jenkins Home') {
            steps {
                script {
                    echo "=== Starting Jenkins Backup ==="

                    // Define the full path for the backup file
                    def backupFile = "${BACKUP_DIR}/${BACKUP_FILE}"

                    // Create backup directory if it doesn't exist
                    sh "mkdir -p ${BACKUP_DIR}"

                    // Compress Jenkins home directory into a single tar.gz file
                    sh """
                        tar -czf ${backupFile} ${JENKINS_HOME_DIR}
                    """

                    echo "✅ Backup completed successfully!"
                    echo "Backup file created at: ${backupFile}"
                }
            }
        }
    }
}
